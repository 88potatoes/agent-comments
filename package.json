{
  "name": "@88potatoes/agent-comments",
  "version": "1.0.4",
  "description": "Inline comment system for code reviews — CLI + nvim plugin",
  "keywords": [
    "code-review",
    "comments",
    "cli"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "bin": {
    "agent-comments": "bin/agent-comments.mjs",
    "aco": "bin/agent-comments.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "drizzle/",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts tui",
    "dev:debug": "AGENT_COMMENTS_DEBUG=1 tsx --watch src/index.ts tui",
    "dev:log": "tail -f tmp/ac-debug.log",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepublishOnly": "pnpm test",
    "prepare": "husky",
    "publish:agent-comments": "bash scripts/publish.sh agent-comments",
    "publish:agent-comments-pi": "bash scripts/publish.sh agent-comments-pi"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@tanstack/react-query": "^5.101.2",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "ink": "^7.1.1",
    "react": "^19.2.7",
    "tsx": "^4.22.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.28.0"
}
